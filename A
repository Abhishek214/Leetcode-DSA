@UserstatsServer.get("/user_adoption", status_code=status.HTTP_200_OK)
async def view_user_adoption(DCREST_JWT_TOKEN: str = Header()):
    """
    Extract unique user counts (distinct PSIDs) grouped by journey and calendar month.
    Output is formatted into a native array matrix matching frontend chart datasets.
    """
    # Token Authentication validation matching application schema
    if not auth(DCREST_JWT_TOKEN):
        return JSONResponse(
            content={"error": "Invalid token"}, 
            status_code=status.HTTP_401_UNAUTHORIZED
        )
        
    try:
        data = get_user_adoption_chart_data()
        if data is not None:
            return jsonable_encoder({"status": "success", "data": data})
        else:
            return JSONResponse(
                content={"status": "error", "message": "Failed to extract chart statistics"},
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR
            )
    except Exception as error:
        logger.error(f"Error in user adoption endpoint execution: {error}")
        return jsonable_encoder({"status": "error", "message": str(error)})
