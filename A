def sanitize_list_filter(filter_list):
    """Removes UI placeholder noise like '-', '', or 'Not Available' from filters"""
    if not filter_list:
        return None
    
    # Filter out common frontend placeholder strings
    cleaned = [x for x in filter_list if x not in (None, "", "-", "Not Available", "UNKNOWN")]
    
    # If the list is now empty after cleaning, return None so the SQL WHERE clause skips it
    return cleaned if len(cleaned) > 0 else None



# Clean the incoming arrays before building the SQL query params
use_case_clean = sanitize_list_filter(filters.get("use_case"))
market_clean = sanitize_list_filter(filters.get("market"))
feature_clean = sanitize_list_filter(filters.get("feature"))
doctype_clean = sanitize_list_filter(filters.get("documentType"))

# Then only append to your WHERE clause if the cleaned filter is NOT None
if use_case_clean:
    where_clause += " AND d.mljourney = ANY(%s)"
    params.append(use_case_clean)
    
if market_clean:
    where_clause += " AND w.market = ANY(%s)"
    params.append(market_clean)
