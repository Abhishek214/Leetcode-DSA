import datetime
from typing import Optional, List

def get_user_adoption_by_year(year: str):
    """
    Fetches user adoption matrix for all available use cases sorted chronologically (Jan -> Dec).
    Filters out future months for the current calendar year.
    """
    conn = getconn()
    cur = conn.cursor()
    
    months_short = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    current_date = datetime.datetime.now()
    current_year = current_date.year
    current_month_idx = current_date.month # 1-indexed
    
    target_year = int(year)
    if target_year == current_year:
        active_months = months_short[:current_month_idx]
    else:
        active_months = months_short
        
    try:
        # Query distinct mljourney values (represented as use cases)
        cur.execute("SELECT DISTINCT COALESCE(mljourney, 'Unknown') FROM public.user_uploaded_document_details;")
        all_use_cases = [row[0] for row in cur.fetchall()]
        
        adoption_staging = {u: {m: 0 for m in active_months} for u in all_use_cases}
        
        query = """
            SELECT 
                TO_CHAR(created_at, 'Mon') as c_month,
                COALESCE(mljourney, 'Unknown') as journey,
                COUNT(DISTINCT psid) as unique_users
            FROM public.user_uploaded_document_details
            WHERE created_at IS NOT NULL AND EXTRACT(YEAR FROM created_at)::INT = %s
            GROUP BY TO_CHAR(created_at, 'Mon'), COALESCE(mljourney, 'Unknown');
        """
        cur.execute(query, (target_year,))
        results = cur.fetchall()
        
        for row in results:
            c_month, db_journey, unique_users = row
            month_clean = c_month.strip().capitalize()
            
            if db_journey in adoption_staging and month_clean in adoption_staging[db_journey]:
                adoption_staging[db_journey][month_clean] += unique_users
        
        year_matrix = [["product"] + active_months]
        for u in all_use_cases:
            row = [u] + [adoption_staging[u][m] for m in active_months]
            year_matrix.append(row)
            
        return {str(year): year_matrix}
    except Exception as e:
        logger.error(f"error compiling lowercase single year user adoption: {e}")
        return None
    finally:
        cur.close()
        conn.close()


def get_user_by_journey_data(filters: dict):
    conn = getconn()
    cur = conn.cursor()
    try:
        where_clause = " WHERE d.created_at IS NOT NULL"
        params = []
        
        if filters.get("start_time"):
            where_clause += " AND d.start_time >= %s"
            params.append(filters["start_time"])
        if filters.get("end_time"):
            where_clause += " AND d.end_time <= %s"
            params.append(filters["end_time"])
        if filters.get("use_case"):
            where_clause += " AND d.mljourney = ANY(%s)"
            params.append(filters["use_case"])
        if filters.get("market"):
            where_clause += " AND w.market = ANY(%s)"
            params.append(filters["market"])
        if filters.get("feature"):
            where_clause += " AND d.feature = ANY(%s)"
            params.append(filters["feature"])
        if filters.get("doctype"):
            where_clause += " AND d.doctype_code = ANY(%s)"
            params.append(filters["doctype"])

        query = f"""
            SELECT COALESCE(d.mljourney, 'Unknown') as journey, COUNT(DISTINCT d.psid) as count
            FROM public.user_uploaded_document_details d
            LEFT JOIN public.table_warden w ON d.psid = w.psid
            {where_clause}
            GROUP BY COALESCE(d.mljourney, 'Unknown');
        """
        cur.execute(query, tuple(params))
        return {row[0].lower(): row[1] for row in cur.fetchall()}
    except Exception as e:
        logger.error(f"error fetching user_by_journey data: {e}")
        return None
    finally:
        cur.close()
        conn.close()


