def get_value_list():
    conn = None
    cur = None

    try:
        conn = getconn()
        if conn is None:
            logger.error("Database connection failed.")
            return {}

        cur = conn.cursor()

        filters = ["mljourney", "feature", "doctype_code", "market"]
        result = {}

        for value in filters:
            cur.execute(
                f"SELECT DISTINCT {value} FROM public.user_uploaded_document_details;"
            )
            result[value] = [row[0] for row in cur.fetchall()]

        return result

    except Exception as e:
        logger.error(f"Failed to fetch records: {e}")
        return {}

    finally:
        if cur:
            cur.close()
        if conn:
            conn.close()
