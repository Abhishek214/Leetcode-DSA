import unittest
from urllib.parse import urlparse

from configurations.params import (
    CDG_UPLOAD_URL,
    CDG_UPLOAD_STATUS,
    global_cdg_download
)


class TestCDGUrls(unittest.TestCase):

    def assert_valid_url(self, url, name):
        self.assertIsNotNone(url, f"{name} is None")
        self.assertNotEqual(url.strip(), "", f"{name} is empty")

        parsed = urlparse(url)

        self.assertIn(
            parsed.scheme,
            ("http", "https"),
            f"{name} is not a valid HTTP/HTTPS URL: {url}"
        )

        self.assertTrue(
            parsed.netloc,
            f"{name} does not contain a valid host: {url}"
        )

    def test_cdg_urls(self):
        self.assert_valid_url(CDG_UPLOAD_URL, "CDG_UPLOAD_URL")
        self.assert_valid_url(CDG_UPLOAD_STATUS, "CDG_UPLOAD_STATUS")
        self.assert_valid_url(global_cdg_download, "global_cdg_download")


if __name__ == "__main__":
    unittest.main()
