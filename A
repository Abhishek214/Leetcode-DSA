export const downloadUserStatExcel = async (data) => {
    try {
        const user = useLoginStore.getState().user;
        
        // 1. Fire the post request (Added missing await)
        const response = await fetch(
            "https://dcrest-internal-uat.uk.hsbc/dcrest-userstats-service/userstats/export-excel",
            {
                method: "POST",
                body: JSON.stringify(data),
                headers: {
                    "DCREST-JWT-TOKEN": user.access_token,
                    "Content-Type": "application/json",
                    "Accept": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                    // Content-Disposition removed from here successfully
                }
            }
        );

        if (!response.ok) throw new Error("Network response was not ok");

        // 2. Convert response stream directly to a blob
        const blob = await response.blob();
        
        // 3. Programmatically trigger the browser download anchor
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = "summary_report.xlsx"; // Fallback client filename
        document.body.appendChild(a);
        a.click();
        
        // 4. Cleanup memory references
        a.remove();
        window.URL.revokeObjectURL(url);

    } catch (error) {
        console.error("Excel download failed:", error);
    }
};
