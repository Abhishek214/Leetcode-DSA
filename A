def alter_table(conn, cur):
    """
    Idempotent migration to add tracking columns to user_uploaded_document_details
    and backfill existing data based on the mljourney code.
    """
    try:
        logger.info("Initializing table structural alterations...")
        
        # 1. Combine all table columns into a single optimized ALTER query
        alter_query = """
            ALTER TABLE public.user_uploaded_document_details 
            ADD COLUMN IF NOT EXISTS market VARCHAR(50), 
            ADD COLUMN IF NOT EXISTS sources_ref_id VARCHAR(100), 
            ADD COLUMN IF NOT EXISTS session_doc_id VARCHAR(100), 
            ADD COLUMN IF NOT EXISTS session_id VARCHAR(100);
        """
        cur.execute(alter_query)
        logger.info("Successfully added tracking columns (or confirmed they already exist).")
        
        # 2. Backfill the market column data based on your rules
        update_query = """
            UPDATE public.user_uploaded_document_details 
            SET market = 'HK' 
            WHERE LOWER(mljourney) = 'hkbbpm';
        """
        cur.execute(update_query)
        logger.info(f"Successfully completed backfill optimization. Rows updated: {cur.rowcount}")
        
        # Commit the transaction block safely
        conn.commit()
        logger.info("All changes committed successfully across the active environment state.")
        
    except Exception as e:
        conn.rollback()
        logger.error(f"Migration sequence broken, transaction rolled back safely: {e}")
        raise e



