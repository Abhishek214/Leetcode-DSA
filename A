def print_compiled_query(query: str, params: list):
    """Placeholder helper to print a formatted look at your SQL query."""
    formatted_query = query
    for param in params:
        # Wrap strings/lists in single quotes for readable display
        if isinstance(param, (str, list, tuple)):
            formatted_query = formatted_query.replace("%s", f"'{param}'", 1)
        else:
            formatted_query = formatted_query.replace("%s", str(param), 1)
    
    print("\n--- DEBUG EXECUTING SQL QUERY ---")
    print(formatted_query)
    print("---------------------------------\n")
