import asyncio
import time
import uuid
import statistics
import argparse
from pathlib import Path
import httpx


async def send_request(
    client: httpx.AsyncClient,
    semaphore: asyncio.Semaphore,
    url: str,
    file_path: Path,
    business: str,
    request_id: int
) -> dict:
    """Sends a single request to the document classification endpoint while tracking duration."""
    doc_ui_id = f"test-doc-{uuid.uuid4().hex[:8]}-{request_id}"
    
    async with semaphore:
        start_time = time.perf_counter()
        try:
            with open(file_path, "rb") as f:
                files = {"Dcrest_File": (file_path.name, f, "application/pdf")}
                data = {
                    "business": business,
                    "document_ui_id": doc_ui_id
                }
                
                response = await client.post(url, files=files, data=data, timeout=300.0)
                duration = time.perf_counter() - start_time
                
                return {
                    "id": request_id,
                    "doc_ui_id": doc_ui_id,
                    "status": response.status_code,
                    "duration": duration,
                    "success": response.status_code == 201,
                    "error": None if response.status_code == 201 else response.text
                }
        except Exception as e:
            duration = time.perf_counter() - start_time
            return {
                "id": request_id,
                "doc_ui_id": doc_ui_id,
                "status": 0,
                "duration": duration,
                "success": False,
                "error": str(e)
            }


async def run_benchmark(
    url: str,
    file_path: str,
    business: str,
    total_requests: int,
    concurrency: int
):
    """Executes the load test suite with configured concurrency."""
    path = Path(file_path)
    if not path.exists():
        print(f"Error: Sample file not found at '{file_path}'")
        return

    print(f"--- Starting Classification Service Load Test ---")
    print(f"Target Endpoint : {url}")
    print(f"Sample File     : {file_path}")
    print(f"Business Type   : {business}")
    print(f"Total Requests  : {total_requests}")
    print(f"Concurrency     : {concurrency}")
    print("-" * 50)

    semaphore = asyncio.Semaphore(concurrency)
    limits = httpx.Limits(max_keepalive_connections=concurrency, max_connections=concurrency * 2)
    
    async with httpx.AsyncClient(limits=limits, verify=False) as client:
        start_total = time.perf_counter()
        tasks = [
            send_request(client, semaphore, url, path, business, i + 1)
            for i in range(total_requests)
        ]
        results = await asyncio.gather(*tasks)
        total_benchmark_time = time.perf_counter() - start_total

    # Analysis & Metrics Evaluation
    successful_requests = [r for r in results if r["success"]]
    failed_requests = [r for r in results if not r["success"]]
    durations = [r["duration"] for r in results]
    successful_durations = [r["duration"] for r in successful_requests]

    print("\n" + "=" * 50)
    print("                TEST RESULTS                    ")
    print("=" * 50)
    print(f"Total Time Elapsed    : {total_benchmark_time:.2f} s")
    print(f"Throughput            : {len(results) / total_benchmark_time:.2f} req/sec")
    print(f"Successful Requests   : {len(successful_requests)} / {total_requests}")
    print(f"Failed Requests       : {len(failed_requests)} / {total_requests}")

    if successful_durations:
        sorted_durations = sorted(successful_durations)
        p50 = statistics.median(sorted_durations)
        p90 = sorted_durations[int(len(sorted_durations) * 0.90) - 1]
        p95 = sorted_durations[int(len(sorted_durations) * 0.95) - 1]

        print("\nLatency Metrics (Seconds):")
        print(f"  Min Duration        : {min(successful_durations):.2f} s")
        print(f"  Average Duration    : {statistics.mean(successful_durations):.2f} s")
        print(f"  Median (P50)        : {p50:.2f} s")
        print(f"  P90 Duration        : {p90:.2f} s")
        print(f"  P95 Duration        : {p95:.2f} s")
        print(f"  Max Duration        : {max(successful_durations):.2f} s")

    if failed_requests:
        print("\nFailure Sample:")
        for failed in failed_requests[:5]:
            print(f"  Req #{failed['id']} failed with status {failed['status']}: {failed['error']}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="DCREST Classification Endpoint Load Tester")
    parser.add_argument("--url", default="http://localhost:8000/dcrest/v1/classification/Feature/docsplit", help="Target API URL")
    parser.add_argument("--file", required=True, help="Path to sample PDF/image file")
    parser.add_argument("--business", default="mandates", help="Business context (e.g., mandates, wpb-irr)")
    parser.add_argument("--requests", type=int, default=20, help="Total requests to dispatch")
    parser.add_argument("--concurrency", type=int, default=5, help="Simultaneous concurrent requests limit")

    args = parser.parse_args()
    asyncio.run(run_benchmark(args.url, args.file, args.business, args.requests, args.concurrency))
