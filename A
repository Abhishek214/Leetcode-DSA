def get_comprehensive_user_metrics():
    conn = getconn()
    cur = conn.cursor()
    
    # Whitelisting array containing all required journeys
    ALLOWED_JOURNEYS = [
        "CMB-KYC", "Servicing", "WPB-IRR", "SOW", "SelfService", 
        "HKBBPM", "SMARTSERVE", "SMARTSERVE-UKBBPM", "Gen AI", "Traditional"
    ]
    # Standard 12-month sequence for matrix columns
    MONTHS_SHORT = ["Dec", "Nov", "Oct", "Sep", "Aug", "Jul", "Jun", "May", "Apr", "Mar", "Feb", "Jan"]
    journey_upper_map = {j.upper(): j for j in ALLOWED_JOURNEYS}
    
    # Root response structure
    payload = {
        "User_adoption": {},
        "User_by_journey": {},
        "User_by_Feature": {},
        "User_by_market": {}
    }
    
    try:
        # Step 1: Query global timeline boundaries (No filters)
        range_query = """
            SELECT 
                EXTRACT(YEAR FROM MIN(created_at))::INT as start_year,
                EXTRACT(YEAR FROM MAX(created_at))::INT as end_year
            FROM public.user_uploaded_document_details
            WHERE created_at IS NOT NULL;
        """
        cur.execute(range_query)
        range_res = cur.fetchone()
        
        if range_res and range_res[0] is not None:
            start_year, end_year = range_res[0], range_res[1]
            for y in range(start_year, end_year + 1):
                payload["User_adoption"][str(y)] = {}
        else:
            from datetime import datetime
            current_y = str(datetime.now().year)
            payload["User_adoption"][current_y] = {}
            start_year = end_year = datetime.now().year

        # Step 2: Initialize clean staging matrix tracking map using pure month names
        adoption_staging = {
            str(y): {j: {m: 0 for m in MONTHS_SHORT} for j in ALLOWED_JOURNEYS} 
            for y in range(start_year, end_year + 1)
        }
        active_data_years = set()

        adoption_query = """
            SELECT 
                EXTRACT(YEAR FROM created_at)::INT as c_year,
                TO_CHAR(created_at, 'Mon') as c_month,
                COALESCE(mljourney, 'Unknown') as journey,
                COUNT(DISTINCT psid) as unique_users
            FROM public.user_uploaded_document_details
            WHERE created_at IS NOT NULL
            GROUP BY EXTRACT(YEAR FROM created_at)::INT, TO_CHAR(created_at, 'Mon'), COALESCE(mljourney, 'Unknown');
        """
        cur.execute(adoption_query)
        results = cur.fetchall()
        
        for row in results:
            c_year, c_month, db_journey, unique_users = row
            if c_year is None or c_month is None or db_journey is None:
                continue
                
            year_str = str(c_year)
            norm_journey = db_journey.strip().upper()
            if norm_journey not in journey_upper_map:
                continue
            canonical_journey = journey_upper_map[norm_journey]
            
            month_clean = c_month.strip().capitalize()
                
            if year_str in adoption_staging and canonical_journey in adoption_staging[year_str]:
                if month_clean in adoption_staging[year_str][canonical_journey]:
                    adoption_staging[year_str][canonical_journey][month_clean] += unique_users
                    if unique_users > 0:
                        active_data_years.add(year_str)

        # Build clean matrices
        for year_key in sorted(adoption_staging.keys()):
            if year_key in active_data_years:
                year_matrix = [["product"] + MONTHS_SHORT]
                for j in ALLOWED_JOURNEYS:
                    row = [j] + [adoption_staging[year_key][j][m] for m in MONTHS_SHORT]
                    year_matrix.append(row)
                payload["User_adoption"][year_key] = year_matrix
            else:
                payload["User_adoption"][year_key] = {}

        # Step 3: Populate global distinct "User_by_journey" distribution map
        journey_query = """
            SELECT COALESCE(mljourney, 'Unknown') as journey, COUNT(DISTINCT psid) as count
            FROM public.user_uploaded_document_details
            WHERE created_at IS NOT NULL
            GROUP BY COALESCE(mljourney, 'Unknown');
        """
        cur.execute(journey_query)
        for row in cur.fetchall():
            payload["User_by_journey"][row[0]] = row[1]

        # Step 4: Populate global distinct "User_by_Feature" distribution map
        feature_query = """
            SELECT COALESCE(feature, 'Unknown') as feature, COUNT(DISTINCT psid) as count
            FROM public.user_uploaded_document_details
            WHERE created_at IS NOT NULL
            GROUP BY COALESCE(feature, 'Unknown');
        """
        cur.execute(feature_query)
        for row in cur.fetchall():
            payload["User_by_Feature"][row[0]] = row[1]

        # STEP 5 FIX: Query market and distinct user counts from the correct "table_warden" table
        market_query = """
            SELECT COALESCE(market, 'Unknown') as market, COUNT(DISTINCT psid) as count
            FROM public.table_warden
            WHERE date IS NOT NULL
            GROUP BY COALESCE(market, 'Unknown');
        """
        cur.execute(market_query)
        for row in cur.fetchall():
            payload["User_by_market"][row[0]] = row[1]

        return payload

    except Exception as e:
        logger.error(f"Error compiling clean global multi-matrix analysis payload: {e}")
        return None
    finally:
        cur.close()
        conn.close()
