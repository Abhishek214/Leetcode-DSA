def get_date_format(date_str):
    patterns = {
        "%d/%m/%Y": "DD/MM/YYYY",
        "%m/%d/%Y": "MM/DD/YYYY",
        "%Y-%m-%d": "YYYY-MM-DD",
        "%d-%m-%Y": "DD-MM-YYYY",
        "%Y/%m/%d": "YYYY/MM/DD",
    }

    import datetime
    for fmt in patterns:
        try:
            datetime.datetime.strptime(date_str, fmt)
            return patterns[fmt]
        except:
            continue
    return "Unknown format"
