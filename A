import asyncio
import json
from pathlib import Path
from typing import Dict, Optional
import docx
from docx.oxml.table import CT_Tbl
from docx.oxml.text.paragraph import CT_P
from docx.table import Table
from docx.text.paragraph import Paragraph


async def get_text_with_retry(
    pdf_path: str, retries: int = 3, delay: float = 2.0
):
    for attempt in range(1, retries + 1):
        try:
            return await get_text_from_pdf(pdf_path)
        except Exception as e:
            if attempt == retries:
                raise
            print(
                f"Attempt {attempt} failed for {Path(pdf_path).name} ({e}). Retrying in {delay * attempt}s..."
            )
            await asyncio.sleep(delay * attempt)


def get_text_from_docx(docx_path: str) -> Dict[str, str]:
    doc = docx.Document(docx_path)
    pages = []
    current_page = []

    for child in doc.element.body.iterchildren():
        if isinstance(child, CT_P):
            para = Paragraph(child, doc)
            if para.paragraph_format.page_break_before and current_page:
                pages.append("\n".join(current_page))
                current_page = []

            if para.text.strip():
                current_page.append(para.text.strip())

            # Split into next Page-N key on explicit Word page breaks
            if child.xpath('.//w:br[@w:type="page"]'):
                pages.append("\n".join(current_page))
                current_page = []

        elif isinstance(child, CT_Tbl):
            table = Table(child, doc)
            for row in table.rows:
                row_text = [
                    cell.text.strip() for cell in row.cells if cell.text.strip()
                ]
                if row_text:
                    current_page.append(" | ".join(row_text))

    if current_page or not pages:
        pages.append("\n".join(current_page))

    return {f"Page-{i + 1}": text for i, text in enumerate(pages)}


async def export_doctype_docs_to_json(
    root_folder: str,
    output_folder: Optional[str] = None,
    max_pages: Optional[int] = 3,
):
    root = Path(root_folder)
    out_dir = Path(output_folder) if output_folder else root
    out_dir.mkdir(parents=True, exist_ok=True)

    for sub in [f for f in root.iterdir() if f.is_dir()]:
        json_path = out_dir / f"{sub.name}.json"

        # Skip doctype if its JSON file already exists
        if json_path.exists():
            print(f"Skipping doctype (already exists): {json_path.name}")
            continue

        doctype_data = {}

        for file_path in sorted(sub.iterdir()):
            # Skip hidden/temporary Word lock files (~$...)
            if not file_path.is_file() or file_path.name.startswith("~$"):
                continue

            ext = file_path.suffix.lower()

            if ext == ".pdf":
                try:
                    extracted_data = await get_text_with_retry(str(file_path))

                    if isinstance(extracted_data, dict):
                        items = list(extracted_data.items())
                        if max_pages is not None:
                            items = items[:max_pages]
                        pages_dict = dict(items)
                    else:
                        pages_dict = {
                            "Page-1": (
                                str(extracted_data) if extracted_data else ""
                            )
                        }

                    doctype_data[file_path.name] = pages_dict
                    print(f"Processed PDF: {file_path.name}")

                except Exception as e:
                    print(f"FAILED {file_path.name} after retries: {e}")
                    doctype_data[file_path.name] = {"error": str(e)}

            elif ext == ".docx":
                try:
                    extracted_data = get_text_from_docx(str(file_path))
                    items = list(extracted_data.items())
                    if max_pages is not None:
                        items = items[:max_pages]
                    doctype_data[file_path.name] = dict(items)
                    print(f"Processed DOCX: {file_path.name}")

                except Exception as e:
                    print(f"FAILED {file_path.name}: {e}")
                    doctype_data[file_path.name] = {"error": str(e)}

        with open(json_path, "w", encoding="utf-8") as f:
            json.dump(doctype_data, f, indent=4, ensure_ascii=False)

        print(f"Saved doctype JSON: {json_path}")


# Run in Jupyter (set max_pages=None if you want all pages instead of first 3):
await export_doctype_docs_to_json(
    root_folder="/opt/disk1/app/Abhishek/DCREST Netherlands",
    output_folder="/opt/disk1/app/Abhishek/DCREST Netherlands",
    max_pages=3,
)
