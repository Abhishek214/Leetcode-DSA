from urllib.parse import urlparse

from configurations.params import (
    CDG_UPLOAD_URL,
    CDG_UPLOAD_STATUS,
    download_api,
)

EXPECTED_HOST = "my-cdg-service.company.com"


def test_cdg_upload_url_host():
    assert urlparse(CDG_UPLOAD_URL).hostname == EXPECTED_HOST


def test_cdg_upload_status_url_host():
    assert urlparse(CDG_UPLOAD_STATUS).hostname == EXPECTED_HOST


def test_cdg_download_url_host():
    assert urlparse(download_api).hostname == EXPECTED_HOST
