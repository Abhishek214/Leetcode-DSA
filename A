def get_span_range(spans):
    """
    Return the start and end character offsets for a collection
    of Azure OCR spans.
    """
    start = min(span.offset for span in spans)
    end = max(
        span.offset + span.length
        for span in spans
    )

    return start, end



# ------------------------------------------------------------
# STEP 3 OPTIMIZATION
# Sequential word/line span matching
# ------------------------------------------------------------

page_response = []

words = page.words or []

word_index = 0

for line in page.lines or []:

    if not line.spans:
        continue

    # Get character range covered by this line
    line_start, line_end = get_span_range(
        line.spans
    )

    # --------------------------------------------------------
    # Move forward through words only once
    # --------------------------------------------------------

    while word_index < len(words):

        word = words[word_index]

        word_start = word.span.offset
        word_end = (
            word.span.offset +
            word.span.length
        )

        # ----------------------------------------------------
        # Word belongs to a previous line
        # ----------------------------------------------------

        if word_end <= line_start:
            word_index += 1
            continue

        # ----------------------------------------------------
        # Word belongs to a future line
        #
        # Since words are ordered, we can stop looking for
        # this line.
        # ----------------------------------------------------

        if word_start >= line_end:
            break

        # ----------------------------------------------------
        # Word belongs to this line
        # ----------------------------------------------------

        word_text = word.content

        word_confidence = word.confidence

        word_bbox = convert_polygon_bbox_pixel(
            word.polygon,
            x_scale,
            y_scale
        )

        page_response.append(
            {
                "word": word_text,
                "bbox": word_bbox,
                "confidence": word_confidence
            }
        )

        word_index += 1


