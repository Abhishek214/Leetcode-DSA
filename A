def get_user_adoption_by_year(year: str):
    """
    Fetches NEW user onboarding matrix for all available journeys sorted chronologically (Jan -> Dec).
    A user is counted only in the month of their first-ever appearance for that journey (global first,
    not just first-in-selected-year). Filters out future months for the current calendar year.
    """
    conn = getconn()
    cur = conn.cursor()

    months_short = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    current_date = datetime.datetime.now()
    current_year = current_date.year
    current_month_idx = current_date.month  # 1-indexed

    target_year = int(year)
    if target_year == current_year:
        active_months = months_short[:current_month_idx]
    else:
        active_months = months_short

    try:
        # First query all distinct journeys present in the table to remove restrictions
        cur.execute("SELECT DISTINCT COALESCE(mljourney, 'Unknown') FROM public.user_uploaded_document_details;")
        all_journeys = [row[0] for row in cur.fetchall()]

        adoption_staging = {j: {m: 0 for m in active_months} for j in all_journeys}

        # Find each user's TRUE first-ever onboarding month per journey (across all history,
        # not just the selected year), then keep only the ones whose onboarding month falls
        # in the target year.
        query = """
            WITH first_seen AS (
                SELECT
                    psid,
                    COALESCE(mljourney, 'Unknown') AS journey,
                    MIN(created_at) AS onboarded_at
                FROM public.user_uploaded_document_details
                WHERE created_at IS NOT NULL
                GROUP BY psid, COALESCE(mljourney, 'Unknown')
            )
            SELECT
                TO_CHAR(onboarded_at, 'Mon') AS c_month,
                journey,
                COUNT(DISTINCT psid) AS new_users
            FROM first_seen
            WHERE EXTRACT(YEAR FROM onboarded_at)::INT = %s
            GROUP BY TO_CHAR(onboarded_at, 'Mon'), journey;
        """

        cur.execute(query, (target_year,))
        results = cur.fetchall()

        for row in results:
            c_month, db_journey, new_users = row
            month_clean = c_month.strip().capitalize()

            if db_journey in adoption_staging and month_clean in adoption_staging[db_journey]:
                adoption_staging[db_journey][month_clean] += new_users

        year_matrix = [["product"] + active_months]
        for j in all_journeys:
            row = [j] + [adoption_staging[j][m] for m in active_months]
            year_matrix.append(row)

        return {str(year): year_matrix}
    except Exception as e:
        logger.error(f"error compiling lowercase single year user adoption: {e}")
        return None
    finally:
        cur.close()
        conn.close()
