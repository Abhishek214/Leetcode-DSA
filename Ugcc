import pandas as pd
import requests
import os
import shutil
import openpyxl
from datetime import datetime

# --- CONFIGURATION ---
EXCEL_FILE_PATH = 'GCP_UAT_Test_results.xlsx'
BASE_PDF_FOLDER = r'C:\Path\To\Your\PDFs'
API_ENDPOINT = 'https://api.your-domain.com/extract'
API_HEADERS = {'Authorization': 'Bearer YOUR_TOKEN'}

# Mapping: Sheet Name -> Subfolder Name (if applicable)
DOC_TYPE_FOLDER_MAP = {
    'Servicing_HKID': '',
    'Servicing_MOM': '',
}

def get_api_extraction(file_path):
    """Sends file to API and returns extracted key-value pairs."""
    try:
        with open(file_path, 'rb') as f:
            files = {'file': f}
            response = requests.post(API_ENDPOINT, files=files, headers=API_HEADERS)
        return response.json() if response.status_code == 200 else {}
    except Exception as e:
        print(f"Request Failed for {file_path}: {e}")
        return {}

def normalize_text(text):
    if pd.isna(text) or text is None: return ""
    return str(text).strip().lower()

def run_process():
    # 1. CREATE DATE-PREFIXED COPY
    date_prefix = datetime.now().strftime("%Y-%m-%d")
    new_excel_path = f"{date_prefix}_{EXCEL_FILE_PATH}"
    shutil.copy2(EXCEL_FILE_PATH, new_excel_path)
    print(f"Created working copy: {new_excel_path}")

    # 2. LOAD WORKBOOK FOR WRITING
    wb = openpyxl.load_workbook(new_excel_path)
    
    # 3. USE PANDAS LOGIC TO IDENTIFY DATA (Same as first code)
    for sheet_name in wb.sheetnames:
        if sheet_name not in DOC_TYPE_FOLDER_MAP:
            continue
            
        print(f"--- Processing Sheet: {sheet_name} ---")
        ws = wb[sheet_name]
        
        # Use pandas to read the layout (easier for coordinate mapping)
        df = pd.read_excel(EXCEL_FILE_PATH, sheet_name=sheet_name, header=None)
        
        row_file_ids = 12  # Excel row 13
        row_attr_start = 14 # Excel row 15
        
        # Iterate columns in steps of 3 (Columns B, E, H...)
        for col_idx in range(1, df.shape[1], 3):
            file_cell_raw = df.iloc[row_file_ids, col_idx]
            
            if pd.isna(file_cell_raw):
                continue
            
            # Extract filename (e.g., "1. 203623236883" or "4. HKID_15.pdf")
            filename = str(file_cell_raw).split(' ', 1)[-1].strip()
            
            # Handle cases where extension might be missing in Excel cell
            if not filename.lower().endswith(('.pdf', '.jpg', '.png')):
                filename += ".pdf"

            print(f"Processing: {filename}")
            
            # Find File
            subfolder = DOC_TYPE_FOLDER_MAP.get(sheet_name, '')
            file_path = os.path.join(BASE_PDF_FOLDER, subfolder, filename)
            
            if not os.path.exists(file_path):
                print(f"File not found: {file_path}")
                continue

            # Fetch API Results
            api_results = get_api_extraction(file_path)

            # 4. REPLACE VALUES IN EXCEL (Using openpyxl)
            curr_row_idx = row_attr_start
            while curr_row_idx < df.shape[0]:
                attr_name = df.iloc[curr_row_idx, 0] # Column A
                
                if pd.isna(attr_name) or 'accuracy' in str(attr_name).lower():
                    break
                
                ground_truth = df.iloc[curr_row_idx, col_idx]
                extracted_val = api_results.get(attr_name, "N/A")
                
                # Comparison logic
                match_flag = 1 if normalize_text(ground_truth) == normalize_text(extracted_val) else 0
                
                # Write to the openpyxl object (1-based indexing)
                # col_idx + 1 = Ground Truth col, + 2 = Extracted, + 3 = Match
                ws.cell(row=curr_row_idx + 1, column=col_idx + 2).value = str(extracted_val)
                ws.cell(row=curr_row_idx + 1, column=col_idx + 3).value = match_flag
                
                curr_row_idx += 1

    # 5. SAVE THE FINAL EXCEL
    wb.save(new_excel_path)
    print(f"Replacement complete. Final file: {new_excel_path}")

if __name__ == "__main__":
    run_process()
