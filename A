from PIL import Image

def convert_multipage_tif_to_pdf(tif_path, pdf_path):
    with Image.open(tif_path) as img:
        pages = []
        
        for i in range(img.n_frames):
            img.seek(i)
            # Create a copy of the frame and convert to RGB
            page = img.convert('RGB')
            pages.append(page)
            
        # Save the first page and append the rest
        if pages:
            pages[0].save(
                pdf_path, 
                save_all=True, 
                append_images=pages[1:]
            )

convert_multipage_tif_to_pdf("document.tif", "document.pdf")
