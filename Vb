def format_category_context(categories_config):
    """
    Converts category config into weighted instructions for the LLM.
    Separates keywords into 'Strong Evidence' (High weight) and 'Supporting Evidence' (Low weight).
    """
    description_lines = []
    
    for category, keywords_dict in categories_config.items():
        # Separate keys based on weights
        # We assume weights >= 8 are 'Strong' (Primary), others are 'Secondary'
        strong_triggers = [k for k, w in keywords_dict.items() if isinstance(w, (int, float)) and w >= 8]
        weak_triggers = [k for k, w in keywords_dict.items() if isinstance(w, (int, float)) and w < 8]
        
        # Fallback if no weights exist or everything is low
        if not strong_triggers and not weak_triggers:
            strong_triggers = list(keywords_dict.keys())

        desc = f"- **{category}**:\n"
        if strong_triggers:
            desc += f"    * STRONG Visual/Text Indicators (Match immediately if seen): {', '.join(strong_triggers[:8])}\n"
        if weak_triggers:
            desc += f"    * Supporting Indicators (Need multiple to confirm): {', '.join(weak_triggers[:8])}\n"
        
        description_lines.append(desc)
    
    return "\n".join(description_lines)





