def get_summary_report(filters: dict):
    conn = getconn()
    cur = conn.cursor()
    try:
        where_clause = " WHERE d.created_at IS NOT NULL"
        params = []
        
        if filters.get("fromDate"):
            where_clause += " AND d.start_time >= %s"
            params.append(filters["fromDate"])
        if filters.get("toDate"):
            where_clause += " AND d.end_time <= %s"
            params.append(filters["toDate"])
        if filters.get("use_case"):
            where_clause += " AND d.mljourney = ANY(%s)"
            params.append(filters["use_case"])
        if filters.get("market"):
            where_clause += " AND w.market = ANY(%s)"
            params.append(filters["market"])
        if filters.get("feature"):
            where_clause += " AND d.feature = ANY(%s)"
            params.append(filters["feature"])
        if filters.get("documentType"):
            where_clause += " AND d.doctype_code = ANY(%s)"
            params.append(filters["documentType"])
            
        count_query = f"""
            SELECT COUNT(*) 
            FROM public.user_uploaded_document_details d
            LEFT JOIN public.table_warden w ON d.psid = w.psid 
            {where_clause};
        """
        cur.execute(count_query, tuple(params))
        total_records = cur.fetchone()[0]
        
        data_query = f"""
            SELECT 
                COALESCE(d.mljourney, 'Unknown') as mljourney,
                COALESCE(d.feature, 'Unknown') as feature,
                COALESCE(d.department, 'Unknown') as department,
                d.psid,
                d.created_at,
                d.doc_name,
                d.status,
                d.rejection_reason,
                d.doc_id,
                d.doctype_code,
                d.start_time,
                d.end_time
            FROM public.user_uploaded_document_details d
            LEFT JOIN public.table_warden w ON d.psid = w.psid
            {where_clause}
            ORDER BY d.created_at DESC
        """
        
        page = filters.get("page")
        records_per_page = filters.get("records")
        
        if page is not None and records_per_page is not None:
            offset = (page - 1) * records_per_page
            data_query += " LIMIT %s OFFSET %s;"
            data_params = params + [records_per_page, offset]
        else:
            data_query += ";"
            data_params = params
            
        cur.execute(data_query, tuple(data_params))
        rows = cur.fetchall()
        
        records_list = []
        for row in rows:
            records_list.append({
                "mljourney": row[0],
                "feature": row[1],
                "department": row[2],
                "psid": row[3],
                "created_at": row[4].strftime("%Y-%m-%d %H:%M:%S") if row[4] else None,
                "doc_name": row[5],
                "status": row[6],
                "rejection_reason": row[7],
                "doc_id": row[8],
                "doctype_code": row[9],
                "start_time": row[10],
                "end_time": row[11]
            })
            
        report_type = filters.get("report_type", "summary")
        result = {
            "total_records": total_records,
            "report_type": report_type.lower(),
            "records": records_list
        }
        
        if page is not None and records_per_page is not None:
            result["current_page"] = page
            result["records_per_page"] = records_per_page
            
        return result
        
    except Exception as e:
        logger.error(f"error in get_summary_report: {e}")
        return None
    finally:
        cur.close()
        conn.close()



from fastapi import Header, status
