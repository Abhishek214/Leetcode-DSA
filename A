import os
import subprocess
import tempfile
import uuid
from io import BytesIO

def extractWordImage(self, filename, file_contents):
    # Converts a DOCX file to PDF bytes using LibreOffice
    # Use an isolated temporary directory and a random UUID so user input never touches disk paths
    with tempfile.TemporaryDirectory() as temp_dir:
        unique_id = uuid.uuid4().hex
        source_file_path = os.path.join(temp_dir, f"{unique_id}.docx")
        output_pdf_path = os.path.join(temp_dir, f"{unique_id}.pdf")

        with open(source_file_path, "wb") as files_:
            files_.write(file_contents)

        self.logger.info(f"DOCX file is read and written on disk in location {source_file_path}")
        self.logger.info(f"The converted docx file will be stored in this directory {temp_dir}")

        args = [
            'libreoffice', '--headless', '--convert-to', 'pdf',
            '--outdir', temp_dir, source_file_path
        ]
        process = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=None)
        self.logger.info(f"LibreOffice stdout: {process.stdout.decode()}")

        if not os.path.exists(output_pdf_path):
            error_msg = (
                f"LibreOffice conversion failed or PDF not found. "
                f"STDOUT: {process.stdout.decode()} STDERR: {process.stderr.decode()}"
            )
            self.logger.error(error_msg)
            raise LibreOfficeError(error_msg)

        with open(output_pdf_path, 'rb') as fh:
            converted_file_contents = BytesIO(fh.read())

    # TemporaryDirectory automatically deletes source_file_path and output_pdf_path on exit
    self.logger.info("The given docx is converted into pdf and read the pdf into bytes and removed the pdf file on disk")
    return converted_file_contents.getvalue()
