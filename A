import requests
import json

# Configuration
BASE_URL = "http://127.0.0.1:8000"  # Update with your actual host/port if different
ENDPOINT = "/user_adoption"         # Update with your router prefix if nested (e.g., /userstats/user_adoption)
MOCK_TOKEN = "your_test_jwt_token_here"

def test_user_adoption():
    url = f"{BASE_URL}{ENDPOINT}"
    
    # Setup headers and query parameters
    headers = {
        "DCREST-JWT-TOKEN": MOCK_TOKEN
    }
    params = {
        "year": "2026"
    }
    
    print(f"Sending GET request to: {url}")
    print(f"Params: {params}\n")
    
    try:
        response = requests.get(url, headers=headers, params=params)
        
        print(f"Response Status Code: {response.status_code}")
        
        if response.status_code == 200:
            print("Success! Response Payload:")
            print(json.dumps(response.json(), indent=4))
        else:
            print("Failed! Response Error Body:")
            print(response.text)
            
    except requests.exceptions.ConnectionError:
        print(f"Error: Could not connect to the server at {BASE_URL}. Is your FastAPI app running?")
    except Exception as e:
        print(f"An unexpected error occurred: {e}")

if __name__ == "__main__":
    test_user_adoption()
