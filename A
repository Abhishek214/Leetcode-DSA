import asyncio
import json
from pathlib import Path
import docx


async def get_text_with_retry(
    pdf_path: str, retries: int = 3, delay: float = 2.0
):
    for attempt in range(1, retries + 1):
        try:
            return await get_text_from_pdf(pdf_path)
        except Exception as e:
            if attempt == retries:
                raise
            print(
                f"Attempt {attempt} failed for {Path(pdf_path).name} ({e}). Retrying in {delay * attempt}s..."
            )
            await asyncio.sleep(delay * attempt)


def get_text_from_docx_pages(docx_path: str) -> dict:
    doc = docx.Document(docx_path)
    pages = []
    current_page = []
    w_type = "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}type"

    for block in doc.element.body:
        tag = block.tag.split("}")[-1]

        if tag == "p":
            para = docx.text.paragraph.Paragraph(block, doc)
            text = para.text.strip()
            if text:
                current_page.append(text)

            # Split on manual page breaks or Word's saved page breaks
            has_break = any(
                el.tag.endswith("lastRenderedPageBreak")
                or (el.tag.endswith("br") and el.get(w_type) == "page")
                for el in block.iter()
            )
            if has_break:
                pages.append("\n".join(current_page))
                current_page = []

        elif tag == "tbl":
            table = docx.table.Table(block, doc)
            for row in table.rows:
                row_text = [
                    cell.text.strip() for cell in row.cells if cell.text.strip()
                ]
                if row_text:
                    current_page.append(" | ".join(row_text))

    if current_page or not pages:
        pages.append("\n".join(current_page))

    return {
        f"Page-{i}": page_text for i, page_text in enumerate(pages, start=1)
    }


async def export_docs_to_page_jsons(
    root_folder: str, output_folder: str = None, max_pages: int = None
):
    root = Path(root_folder)
    out_dir = Path(output_folder) if output_folder else root
    out_dir.mkdir(parents=True, exist_ok=True)

    for sub in [f for f in root.iterdir() if f.is_dir()]:
        sub_out_dir = out_dir / sub.name
        sub_out_dir.mkdir(parents=True, exist_ok=True)

        for file_path in sorted(sub.iterdir()):
            if not file_path.is_file() or file_path.name.startswith("~$"):
                continue

            ext = file_path.suffix.lower()
            if ext not in {".pdf", ".docx"}:
                continue

            json_path = sub_out_dir / f"{file_path.stem}.json"

            # Resume support: skip already-processed documents
            if json_path.exists():
                print(f"Skipping (already exists): {json_path.name}")
                continue

            try:
                if ext == ".pdf":
                    extracted = await get_text_with_retry(str(file_path))
                else:
                    extracted = get_text_from_docx_pages(str(file_path))

                # Normalize output to {"Page-1": "...", "Page-2": "..."}
                if isinstance(extracted, dict):
                    items = list(extracted.items())
                    if max_pages:
                        items = items[:max_pages]
                    page_dict = dict(items)
                else:
                    page_dict = {"Page-1": str(extracted) if extracted else ""}

                with open(json_path, "w", encoding="utf-8") as f:
                    json.dump(page_dict, f, indent=4, ensure_ascii=False)

                print(f"Saved: {json_path}")

            except Exception as e:
                print(f"FAILED {file_path.name}: {e}")


# Run in Jupyter (saves all pages per document; pass max_pages=3 if you want to cap pages):
