@UserstatsServer.get("/user_adoption", status_code=status.HTTP_200_OK)
async def view_user_adoption(
    year: str = Query(...),
    DCREST_JWT_TOKEN: str = Header()
):
    if not auth(DCREST_JWT_TOKEN):
        return JSONResponse(content={"error": "Invalid token"}, status_code=status.HTTP_401_UNAUTHORIZED)
        
    data = get_user_adoption_by_year(year)
    if data is not None:
        return jsonable_encoder({"status": "success", "data": {"user_adoption": data}})
    return JSONResponse(content={"status": "error", "message": "Failed to compile user adoption data"}, status_code=500)


