def execute_raw_admin_query(sql_query: str) -> dict:
    """
    Executes an arbitrary administrative SQL query. 
    Automatically commits modifications or returns selected rows.
    """
    conn = getconn()
    cur = conn.cursor()
    try:
        cur.execute(sql_query)
        
        # Check if the query returns rows (e.g., SELECT)
        if cur.description is not None:
            columns = [desc[0] for desc in cur.description]
            rows = cur.fetchall()
            results = [dict(zip(columns, row)) for row in rows]
            return {
                "type": "SELECT",
                "row_count": len(results),
                "data": results
            }
        else:
            # Query was a modification statement (UPDATE, INSERT, DELETE)
            conn.commit()
            return {
                "type": "WRITE/MODIFICATION",
                "row_count": cur.rowcount,
                "data": []
            }
    except Exception as e:
        conn.rollback()
        logger.error(f"Admin raw query execution failed: {e}")
        raise e
    finally:
        cur.close()
        conn.close()



from pydantic import BaseModel
from fastapi import Header, status
from fastapi.responses import JSONResponse
from util.db_handler import execute_raw_admin_query

# Request payload schema
class AdminQueryRequest(BaseModel):
    query: str

@UserstatsServer.post("/admin/execute-raw-query", status_code=status.HTTP_200_OK)
async def run_admin_sql(
    payload: AdminQueryRequest,
    DCREST_JWT_TOKEN: str = Header()
):
    """
    Administrative gateway to execute raw SQL queries on the database instance.
    """
    if not auth(DCREST_JWT_TOKEN):
        return JSONResponse(
            content={"error": "Invalid token"}, 
            status_code=status.HTTP_401_UNAUTHORIZED
        )
        
    if not payload.query.strip():
        return JSONResponse(
            content={"status": "error", "message": "SQL query payload cannot be blank"},
            status_code=status.HTTP_400_BAD_REQUEST
        )
        
    try:
        execution_report = execute_raw_admin_query(payload.query)
        return {
            "status": "success",
            "report": execution_report
        }
    except Exception as error:
        return JSONResponse(
            content={"status": "error", "message": str(error)},
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR
        )



