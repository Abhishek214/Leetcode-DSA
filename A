def get_user_adoption_by_year(year: str):
    """
    Fetches user adoption matrix strictly filtered by a target calendar year.
    """
    conn = getconn()
    cur = conn.cursor()
    
    ALLOWED_JOURNEYS = [
        "CMB-KYC", "Servicing", "WPB-IRR", "SOW", "SelfService", 
        "HKBBPM", "SMARTSERVE", "SMARTSERVE-UKBBPM", "Gen AI", "Traditional"
    ]
    MONTHS_SHORT = ["Dec", "Nov", "Oct", "Sep", "Aug", "Jul", "Jun", "May", "Apr", "Mar", "Feb", "Jan"]
    journey_upper_map = {j.upper(): j for j in ALLOWED_JOURNEYS}
    
    try:
        adoption_staging = {j: {m: 0 for m in MONTHS_SHORT} for j in ALLOWED_JOURNEYS}
        
        query = """
            SELECT 
                TO_CHAR(created_at, 'Mon') as c_month,
                COALESCE(mljourney, 'Unknown') as journey,
                COUNT(DISTINCT psid) as unique_users
            FROM public.user_uploaded_document_details
            WHERE created_at IS NOT NULL AND EXTRACT(YEAR FROM created_at)::INT = %s
            GROUP BY TO_CHAR(created_at, 'Mon'), COALESCE(mljourney, 'Unknown');
        """
        cur.execute(query, (int(year),))
        results = cur.fetchall()
        
        for row in results:
            c_month, db_journey, unique_users = row
            norm_journey = db_journey.strip().upper()
            if norm_journey not in journey_upper_map:
                continue
            canonical_journey = journey_upper_map[norm_journey]
            month_clean = c_month.strip().capitalize()
            
            if month_clean in adoption_staging[canonical_journey]:
                adoption_staging[canonical_journey][month_clean] += unique_users
        
        year_matrix = [["product"] + MONTHS_SHORT]
        for j in ALLOWED_JOURNEYS:
            row = [j] + [adoption_staging[j][m] for m in MONTHS_SHORT]
            year_matrix.append(row)
            
        return {year: year_matrix}
    except Exception as e:
        logger.error(f"Error compiling filtered single year user adoption: {e}")
        return None
    finally:
        cur.close()
        conn.close()


def get_user_by_journey_data(filters: dict):
    """
    Fetches unique user counts grouped by operational journeys with full filters.
    """
    conn = getconn()
    cur = conn.cursor()
    try:
        where_clause = " WHERE d.created_at IS NOT NULL"
        params = []
        
        if filters.get("start_time"):
            where_clause += " AND d.start_time >= %s"
            params.append(filters["start_time"])
        if filters.get("end_time"):
            where_clause += " AND d.end_time <= %s"
            params.append(filters["end_time"])
        if filters.get("journey"):
            where_clause += " AND UPPER(d.mljourney) = UPPER(%s)"
            params.append(filters["journey"])
        if filters.get("market"):
            where_clause += " AND w.market = %s"
            params.append(filters["market"])
        if filters.get("feature"):
            where_clause += " AND d.feature = %s"
            params.append(filters["feature"])
        if filters.get("doctype"):
            where_clause += " AND d.doctype_code = %s"
            params.append(filters["doctype"])

        query = f"""
            SELECT COALESCE(d.mljourney, 'Unknown') as journey, COUNT(DISTINCT d.psid) as count
            FROM public.user_uploaded_document_details d
            LEFT JOIN public.table_warden w ON d.psid = w.psid
            {where_clause}
            GROUP BY COALESCE(d.mljourney, 'Unknown');
        """
        cur.execute(query, tuple(params))
        return {row[0]: row[1] for row in cur.fetchall()}
    except Exception as e:
        logger.error(f"Error fetching user_by_journey data: {e}")
        return None
    finally:
        cur.close()
        conn.close()


