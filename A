def get_paginated_summary(page: int, records_per_page: int):
    """
    Fetches a specific page slice of summary records from the document details table.
    """
    conn = getconn()
    cur = conn.cursor()
    
    # Calculate offset
    offset = (page - 1) * records_per_page
    
    try:
        # 1. Get total record count for pagination metadata
        count_query = "SELECT COUNT(*) FROM public.user_uploaded_document_details;"
        cur.execute(count_query)
        total_records = cur.fetchone()[0]
        
        # 2. Fetch the specific slice of records
        data_query = """
            SELECT 
                psid, 
                COALESCE(mljourney, 'Unknown') as journey, 
                COALESCE(feature, 'Unknown') as feature, 
                COALESCE(doctype_code, 'Unknown') as doctype,
                created_at
            FROM public.user_uploaded_document_details
            ORDER BY created_at DESC
            LIMIT %s OFFSET %s;
        """
        cur.execute(data_query, (records_per_page, offset))
        rows = cur.fetchall()
        
        # Format database rows into dictionary list objects
        summary_list = []
        for row in rows:
            summary_list.append({
                "psid": row[0],
                "journey": row[1],
                "feature": row[2],
                "doctype": row[3],
                "created_at": row[4].strftime("%Y-%m-%d %H:%M:%S") if row[4] else None
            })
            
        return {
            "total_records": total_records,
            "current_page": page,
            "records_per_page": records_per_page,
            "records": summary_list
        }
        
    except Exception as e:
        logger.error(f"Error fetching paginated summary views: {e}")
        return None
    finally:
        cur.close()
        conn.close()




from fastapi import Header, Query, status
from fastapi.encoders import jsonable_encoder
from fastapi.responses import JSONResponse
from util.db_handler import get_paginated_summary

@UserstatsServer.get("/view_summary", status_code=status.HTTP_200_OK)
async def view_summary(
    page: int = Query(..., ge=1, description="The target page number (starts at 1)"),
    records: int = Query(..., ge=1, le=100, description="Number of items to fetch per page"),
    DCREST_JWT_TOKEN: str = Header()
):
    """
    Provides a cleanly paginated slice of transactional document summaries.
    """
    if not auth(DCREST_JWT_TOKEN):
        return JSONResponse(
            content={"error": "Invalid token"}, 
            status_code=status.HTTP_401_UNAUTHORIZED
        )
        
    try:
        paginated_data = get_paginated_summary(page, records)
        if paginated_data is not None:
            return jsonable_encoder({
                "status": "success", 
                "data": paginated_data
            })
        else:
            return JSONResponse(
                content={"status": "error", "message": "Failed to compile system summary rows"},
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR
            )
    except Exception as error:
        logger.error(f"Error handling paginated summary viewing request: {error}")
        return jsonable_encoder({"status": "error", "message": str(error)})
