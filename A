def get_summary_report(report_type: str, start_time: Optional[str], end_time: Optional[str], page: Optional[int] = None, records_per_page: Optional[int] = None):
    """
    Fetches unconditionally paginated summaries matching the original get_user_stats matrix format exactly.
    """
    conn = getconn()
    cur = conn.cursor()
    
    try:
        where_clause = " WHERE created_at IS NOT NULL"
        params = []
        
        if start_time:
            where_clause += " AND start_time >= %s"
            params.append(start_time)
        if end_time:
            where_clause += " AND end_time <= %s"
            params.append(end_time)
            
        count_query = f"SELECT COUNT(*) FROM public.user_uploaded_document_details {where_clause};"
        cur.execute(count_query, tuple(params))
        total_records = cur.fetchone()[0]
        
        # Matches original column layouts precisely
        data_query = f"""
            SELECT 
                COALESCE(mljourney, 'Unknown') as mljourney,
                COALESCE(feature, 'Unknown') as feature,
                COALESCE(department, 'Unknown') as department,
                psid,
                created_at,
                doc_name,
                status,
                rejection_reason,
                doc_id,
                doctype_code,
                start_time,
                end_time
            FROM public.user_uploaded_document_details
            {where_clause}
            ORDER BY created_at DESC
        """
        
        if page is not None and records_per_page is not None:
            offset = (page - 1) * records_per_page
            data_query += " LIMIT %s OFFSET %s;"
            data_params = params + [records_per_page, offset]
        else:
            data_query += ";"
            data_params = params
            
        cur.execute(data_query, tuple(data_params))
        rows = cur.fetchall()
        
        records_list = []
        for row in rows:
            records_list.append({
                "mljourney": row[0],
                "feature": row[1],
                "department": row[2],
                "psid": row[3],
                "created_at": row[4].strftime("%Y-%m-%d %H:%M:%S") if row[4] else None,
                "doc_name": row[5],
                "status": row[6],
                "rejection_reason": row[7],
                "doc_id": row[8],
                "doctype_code": row[9],
                "start_time": row[10],
                "end_time": row[11]
            })
            
        result = {
            "total_records": total_records,
            "report_type": report_type.lower(),
            "records": records_list
        }
        
        if page is not None and records_per_page is not None:
            result["current_page"] = page
            result["records_per_page"] = records_per_page
            
        return result
        
    except Exception as e:
        logger.error(f"error in get_summary_report: {e}")
        return None
    finally:
        cur.close()
        conn.close()


from fastapi import Header, Query, status
from fastapi.encoders import jsonable_encoder
from fastapi.responses import JSONResponse
from typing import Optional, List
from util.db_handler import (
    get_user_adoption_by_year,
    get_user_by_journey_data,
    get_user_by_feature_data,
    get_user_by_market_data,
    get_summary_report
)

@UserstatsServer.get("/user_adoption", status_code=status.HTTP_200_OK)
async def view_user_adoption(
    year: str = Query(...),
    DCREST_JWT_TOKEN: str = Header()
):
    if not auth(DCREST_JWT_TOKEN):
        return JSONResponse(content={"error": "Invalid token"}, status_code=status.HTTP_401_UNAUTHORIZED)
        
    data = get_user_adoption_by_year(year)
    if data is not None:
        return jsonable_encoder({"status": "success", "data": {"user_adoption": data}})
    return JSONResponse(content={"status": "error", "message": "Failed to compile user adoption data"}, status_code=500)


