def answer_two():
    from sklearn.linear_model import LinearRegression
    from sklearn.preprocessing import PolynomialFeatures
    from sklearn.metrics import r2_score

    r2_train = []
    r2_test = []
    
    X_train_reshaped = X_train.reshape(-1, 1)
    X_test_reshaped = X_test.reshape(-1, 1)

    for degree in range(10):
        poly = PolynomialFeatures(degree=degree)
        X_poly_train = poly.fit_transform(X_train_reshaped)
        X_poly_test = poly.transform(X_test_reshaped)
        
        linreg = LinearRegression().fit(X_poly_train, y_train)
        
        r2_train.append(linreg.score(X_poly_train, y_train))
        r2_test.append(linreg.score(X_poly_test, y_test))
        
    return (np.array(r2_train), np.array(r2_test))




