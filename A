
from sklearn.metrics import precision_recall_curve
import numpy as np

# Use decision_function or predict_proba depending on the model
if hasattr(m, "decision_function"):
    y_scores = m.decision_function(X_test)
else:
    y_scores = m.predict_proba(X_test)[:, 1]

precision, recall, thresholds = precision_recall_curve(y_test, y_scores)

# Find the index where recall is closest to 0.8
idx = (np.abs(recall - 0.8)).argmin()
print(f"Precision at recall ~0.8: {precision[idx]:.3f}")



