# ==================== Secret Receipt Endpoint ====================
class SecretReceiptEndpoint:
    """POST /secret-receipt - Credential Management"""
    
    REQUEST_BODY = {
        "requestBody": {
            "content": {
                "application/x-www-form-urlencoded": {
                    "schema": {
                        "type": "object",
                        "properties": {
                            "secretName": {
                                "type": "string",
                                "description": "Name of the secret key",
                                "example": "dcrestai-gb-dcrest-svc-aco-doctager-pwd"
                            },
                            "secretValue": {
                                "type": "string",
                                "description": "Value of the secret",
                                "example": "encrypted_secret_value_here"
                            }
                        },
                        "required": ["secretName", "secretValue"]
                    }
                }
            }
        }
    }
    
    RESPONSE_BODY = {
        200: {
            "description": "Secret received successfully",
            "content": {
                "application/json": {
                    "example": {
                        "secretName": "dcrestai-gb-dcrest-svc-aco-doctager-pwd",
                        "secretValue": "***********"
                    }
                }
            }
        }
    }


