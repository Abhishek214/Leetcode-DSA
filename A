def get_grouped_years_adoption_chart_data(filters: dict):
    conn = getconn()
    cur = conn.cursor()
    
    # White-listed journeys criteria definition
    ALLOWED_JOURNEYS = [
        "CMB-KYC", "Servicing", "WPB-IRR", "SOW", 
        "SelfService", "HKBBPM", "SMARTSERVE", "SMARTSERVE-UKBBPM"
    ]
    # Exact 12-month abbreviation sequence from your format layout
    MONTHS_SHORT = ["Dec", "Nov", "Oct", "Sep", "Aug", "Jul", "Jun", "May", "Apr", "Mar", "Feb", "Jan"]
    
    # Build case-insensitive canonical lookup dictionary map
    journey_upper_map = {j.upper(): j for j in ALLOWED_JOURNEYS}
    
    try:
        # Replicating sequential dynamic query filter building pattern
        where_clause = " WHERE created_at IS NOT NULL"
        params = []
        
        if filters.get("start_time") is not None:
            where_clause += " AND start_time >= %s"
            params.append(filters["start_time"])
            
        if filters.get("end_time") is not None:
            where_clause += " AND end_time <= %s"
            params.append(filters["end_time"])
            
        if filters.get("journey") is not None:
            where_clause += " AND UPPER(mljourney) = UPPER(%s)"
            params.append(filters["journey"])
            
        if filters.get("market") is not None:
            where_clause += " AND market = %s"
            params.append(filters["market"])
            
        if filters.get("feature") is not None:
            where_clause += " AND feature = %s"
            params.append(filters["feature"])
            
        if filters.get("doctype") is not None:
            where_clause += " AND doctype_code = %s"
            params.append(filters["doctype"])

        # FIX FOR ISSUE 2: Determine which journeys should be visible in the output matrix
        filter_journey = filters.get("journey")
        if filter_journey:
            visible_journeys = [j for j in ALLOWED_JOURNEYS if j.upper() == filter_journey.strip().upper()]
        else:
            visible_journeys = ALLOWED_JOURNEYS

        # Step 1: Detect bounding years available within database under current filters
        range_query = f"""
            SELECT 
                EXTRACT(YEAR FROM MIN(created_at))::INT as start_year,
                EXTRACT(YEAR FROM MAX(created_at))::INT as end_year
            FROM public.user_uploaded_document_details
            {where_clause};
        """
        cur.execute(range_query, tuple(params))
        range_res = cur.fetchone()
        
        # Initialize final mapping container structures
        structured_map = {}
        
        if range_res and range_res[0] is not None:
            start_year, end_year = range_res[0], range_res[1]
            for y in range(start_year, end_year + 1):
                structured_map[str(y)] = {j: {m: 0 for m in MONTHS_SHORT} for j in ALLOWED_JOURNEYS}
        else:
            from datetime import datetime
            current_y = str(datetime.now().year)
            structured_map[current_y] = {j: {m: 0 for m in MONTHS_SHORT} for j in ALLOWED_JOURNEYS}

        # Step 2: Fetch unique distinct counts grouped by Year, Short-Month, and Journey
        query = f"""
            SELECT 
                EXTRACT(YEAR FROM created_at)::INT as c_year,
                TO_CHAR(created_at, 'Mon') as c_month,
                COALESCE(mljourney, 'Unknown') as journey,
                COUNT(DISTINCT psid) as unique_users
            FROM public.user_uploaded_document_details
            {where_clause}
            GROUP BY EXTRACT(YEAR FROM created_at)::INT, TO_CHAR(created_at, 'Mon'), COALESCE(mljourney, 'Unknown');
        """
        cur.execute(query, tuple(params))
        results = cur.fetchall()
        
        # Step 3: Populate database metrics into our structured year maps
        for row in results:
            c_year, c_month, db_journey, unique_users = row
            
            if c_year is None or c_month is None or db_journey is None:
                continue
                
            year_str = str(c_year)
            month_clean = c_month.strip().capitalize()
            norm_journey_key = db_journey.strip().upper()
            
            if norm_journey_key not in journey_upper_map:
                continue
            canonical_journey = journey_upper_map[norm_journey_key]
            
            if year_str in structured_map and month_clean in structured_map[year_str][canonical_journey]:
                structured_map[year_str][canonical_journey][month_clean] += unique_users

        # Step 4: Compile matrices and drop empty years / unrequested journeys
        final_chart_json = {}
        for year_key in sorted(structured_map.keys()):
            year_matrix = [["product"] + MONTHS_SHORT]
            has_data = False  # Track if this entire year has any non-zero data
            
            # Loop only over the visible journeys (Fixes Issue 2)
            for j in visible_journeys:
                row_values = [structured_map[year_key][j][m] for m in MONTHS_SHORT]
                
                # If any month contains actual data, mark this year as active
                if any(val > 0 for val in row_values):
                    has_data = True
                    
                row = [j] + row_values
                year_matrix.append(row)
            
            # FIX FOR ISSUE 1: Only add the year to the final object if it contains data
            if has_data:
                final_chart_json[year_key] = year_matrix
            
        return final_chart_json

    except Exception as e:
        logger.error(f"Error compiling grouped multi-year chart layout: {e}")
        return None
    finally:
        cur.close()
        conn.close()
