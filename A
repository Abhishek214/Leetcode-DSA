from contextlib import asynccontextmanager
from fastapi import FastAPI
from util.db_handler import run_database_migration

@asynccontextmanager
async def lifespan(app: FastAPI):
    # This runs the moment the server process initializes
    run_database_migration()
    yield
    # Any shutdown cleanup goes here

app = FastAPI(lifespan=lifespan)


def run_database_migration():
    """
    Called by Application.py on startup. Fetches a real connection,
    runs the toggleable migration, and safely closes the database handles.
    """
    conn = None
    cur = None
    try:
        logger.info("Connecting to the physical database for startup migration check...")
        
        # ⚠️ REPLACE 'get_db_connection()' WITH YOUR ACTUAL DB POOL OR FACTORY FUNCTION
        # Example: conn = your_connection_pool.getconn() or standard psycopg2.connect()
        conn = get_db_connection() 
        cur = conn.cursor()
        
        # Pass the live connection and cursor to your migration function
        alter_table(conn, cur)
        
    except Exception as e:
        # We catch the exception here so a database connection failure 
        # doesn't completely crash and brick your entire server startup sequence.
        logger.error(f"❌ Startup migration execution failed: {e}")
    finally:
        if cur:
            cur.close()
        if conn:
            conn.close()
        logger.info("Database migration handles cleaned up successfully.")
