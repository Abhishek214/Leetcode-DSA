# --- STEP 2: INGEST DOCUMENT (Upload) ---
# Note: The URL in your image had query parameters cut off (?titl...). 
# Add them to the URL string below if required.
url_ingest = "https://dcrest-dev-ingest-service.azurewebsites.net/ingest/lydia?title=DocumentTitle"

print(f"\n--- 2. Ingesting File ({url_ingest}) ---")
# Open the file in binary mode
try:
    with open(FILE_PATH, 'rb') as f:
        files = {'file': f}
        # Note: requests adds the correct multipart/form-data header automatically
        response_ingest = requests.post(url_ingest, headers=headers, files=files)
        print(f"Status Code: {response_ingest.status_code}")
        print(f"Response: {response_ingest.text}")
except FileNotFoundError:
    print(f"Error: File not found at {FILE_PATH}")


