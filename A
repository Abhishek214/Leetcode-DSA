                if label != 'UNKNOWN_DOCTYPE':
                    # We found the first non-unknown page!
                    anchor_label = label
                    data[i+1] = label
                    
                    # Backfill any previous pages that were UNKNOWN
                    if pending_unknown_pages:
                        logger.info(f"Backfilling {len(pending_unknown_pages)} previous UNKNOWN pages with anchor label: {anchor_label}")
                        for page_num in pending_unknown_pages:
                            data[page_num] = anchor_label
                        pending_unknown_pages = [] # Clear list
                else:
                    # Current page is unknown, and we haven't found an anchor yet
                    data[i+1] = label
                    pending_unknown_pages.append(i+1)
            else:
                # Anchor is already established; standard assignment
                data[i+1] = label

            scores[i+1] = score
