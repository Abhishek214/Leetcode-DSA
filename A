def convert_polygon_bbox_pixel_new(
    polygon,
    x_scale,
    y_scale
):
    x = polygon[::2]
    y = polygon[1::2]

    xmin = min(x)
    ymin = min(y)
    xmax = max(x)
    ymax = max(y)

    return (
        int(xmin * x_scale),
        int(ymin * y_scale),
        int(xmax * x_scale),
        int(ymax * y_scale)
    )


