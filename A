from unittest.mock import MagicMock, patch
import io
import util.db_handler as db_handler
from dcrest_logger.logger import logger

def test_export_excel_stream_success():
    """
    Verifies that the export engine fetches data, populates an excel workbook,
    and returns a readable binary stream pointer positioned at index 0.
    """
    mock_filters = {
        "report_type": "summary",
        "market": ["HK"],
        "use_case": ["HKBBPM"]
    }
    
    # Mock output buffer to mimic an in-memory file write
    fake_buffer = io.BytesIO()
    
    # Patch the internal workspace where your data engine compiles rows
    with patch('util.db_handler.getconn') as mock_getconn:
        mock_conn = MagicMock()
        mock_cur = MagicMock()
        mock_getconn.return_value = mock_conn
        mock_conn.cursor.return_value = mock_cur
        
        # Simulate a mock database row dataset matching your table schemas
        mock_cur.fetchall.return_value = [
            (1, "test_file.pdf", "HK", "HKBBPM", "Warden", "SYSTEM", "2026-06-25")
        ]
        # Simulate column descriptions
        mock_cur.description = [
            ("id",), ("filename",), ("market",), ("mljourney",), 
            ("feature",), ("department",), ("created_at",)
        ]

        # Invoke the database stream function
        result_buffer = db_handler.export_summary_to_excel_stream(mock_filters)
        
        # 1. Ensure the return object is a valid memory stream
        assert isinstance(result_buffer, io.BytesIO)
        
        # 2. Crucial Check: Ensure the buffer stream was rewound to position 0 for consumption
        assert result_buffer.tell() == 0
        
        logger.info("✅ Export pipeline stream structure verified successfully.")

def test_export_excel_stream_empty_handling():
    """
    Ensures that if no data filters match, the system handles it gracefully 
    without throwing a breakdown exception.
    """
    mock_filters = {"report_type": "summary", "market": ["INVALID_MK"]}
    
    with patch('util.db_handler.getconn') as mock_getconn:
        mock_conn = MagicMock()
        mock_cur = MagicMock()
        mock_getconn.return_value = mock_conn
        mock_conn.cursor.return_value = mock_cur
        
        # Return nothing from DB
        mock_cur.fetchall.return_value = []
        
        result_buffer = db_handler.export_summary_to_excel_stream(mock_filters)
        
        # Verify it still yields a valid structural wrapper file instead of crashing
        assert result_buffer is not None
        logger.info("✅ Empty query fallback state handled gracefully.")

if __name__ == "__main__":
    try:
        test_export_excel_stream_empty_handling()
        test_export_excel_stream_success()
        logger.info(f"✅ Pvt passed for {JIRA}")
    except AssertionError as err:
        logger.error(f"❌ Pvt failed validation assertions for {JIRA}")
        raise err
