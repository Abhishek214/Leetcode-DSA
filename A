def get_all_years_adoption_chart_data():
    conn = getconn()
    cur = conn.cursor()
    
    try:
        # 1. Find the boundaries of operational years (filtering out rows with NULL timestamps)
        range_query = """
            SELECT 
                EXTRACT(YEAR FROM MIN(created_at))::INT as start_year,
                EXTRACT(YEAR FROM MAX(created_at))::INT as end_year
            FROM public.user_uploaded_document_details
            WHERE created_at IS NOT NULL;
        """
        cur.execute(range_query)
        range_res = cur.fetchone()
        
        # Safe fallback if table contains no rows with timestamps
        if not range_res or range_res[0] is None:
            return [["product"]]

        start_year, end_year = range_res[0], range_res[1]
        
        # 2. Dynamically build chronological headers from newest month to oldest month
        # Structure format matching: "Dec - 2026", "Nov - 2026" ... "Jan - 2024"
        months_headers = []
        months_short = ["Dec", "Nov", "Oct", "Sep", "Aug", "Jul", "Jun", "May", "Apr", "Mar", "Feb", "Jan"]
        
        for year in range(end_year, start_year - 1, -1):
            for m in months_short:
                months_headers.append(f"{m} - {year}")

        # 3. Pull user aggregation metrics while filtering out records missing a timestamp
        query = """
            SELECT 
                COALESCE(mljourney, 'Unknown') as journey,
                TO_CHAR(created_at, 'Mon - YYYY') as month_year,
                COUNT(DISTINCT psid) as unique_users
            FROM public.user_uploaded_document_details
            WHERE created_at IS NOT NULL
            GROUP BY COALESCE(mljourney, 'Unknown'), TO_CHAR(created_at, 'Mon - YYYY');
        """
        cur.execute(query)
        results = cur.fetchall()
        
        # 4. Initialize structural mapping dictionary
        matrix = {}
        for row in results:
            journey, month_year, unique_users = row
            
            # Explicit guard: skip processing if database somehow returned a null string representation
            if month_year is None:
                continue
                
            # Clean string and fix capitalization anomalies to guarantee it hooks cleanly into our Python headers
            month_year_clean = " ".join(month_year.strip().split()) # Trims interior and exterior spaces
            # Ensure proper capitalization match (e.g., converting "dec - 2025" to "Dec - 2025" if database locales differ)
            parts = month_year_clean.split(" - ")
            if len(parts) == 2:
                month_year_clean = f"{parts[0].strip().capitalize()} - {parts[1].strip()}"
            
            if journey not in matrix:
                # Pre-populate complete matrix rows with zeros to handle missing data cleanly
                matrix[journey] = {m: 0 for m in months_headers}
                
            if month_year_clean in matrix[journey]:
                matrix[journey][month_year_clean] = unique_users

        # 5. Compile into the expected array payload layout matrix
        chart_data = [["product"] + months_headers]
        
        for journey, month_counts in matrix.items():
            row = [journey] + [month_counts[m] for m in months_headers]
            chart_data.append(row)
            
        return chart_data

    except Exception as e:
        logger.error(f"Error executing dynamic multi-year user adoption aggregation: {e}")
        return None
    finally:
        cur.close()
        conn.close()
