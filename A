@UserstatsServer.post("/user_by_journey", status_code=status.HTTP_200_OK)
async def view_user_by_journey(
    payload: AnalyticsFilterRequest,
    DCREST_JWT_TOKEN: str = Header()
):
    if not auth(DCREST_JWT_TOKEN):
        return JSONResponse(content={"error": "Invalid token"}, status_code=status.HTTP_401_UNAUTHORIZED)
        
    filters = payload.model_dump(exclude_none=True)
    data = get_user_by_journey_data(filters)
    if data is not None:
        return jsonable_encoder({"status": "success", "data": {"user_by_journey": data}})
    return JSONResponse(content={"status": "error", "message": "Failed to compile journey analytics"}, status_code=500)


