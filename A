def classify_document_with_scoring(document, business, categories):
    document_lower = document.lower()
    # keyword_scores will store: { "CategoryName": { "keyword1": count, "keyword2": count } }
    keyword_details = {category: {} for category in categories}
    total_category_scores = {category: 0 for category in categories}

    for category, keywords in categories.items():
        for keyword, weight in keywords.items():
            # Standardizing search based on your existing logic
            if category in ['HKID', 'Email', 'National_identity_card', 'Certificate Of Incumbency', 'Certificate Of Incorporation', 'AOA']:
                if category == "HKID":
                    clean_doc = document.replace(' ', '')
                    pattern = fr"{keyword.replace('-', r'[\-:\s]')}"
                    matches = re.findall(pattern, clean_doc, re.IGNORECASE)
                else:
                    matches = re.findall(fr"\b{keyword}\b", document_lower, re.IGNORECASE)
            else:
                matches = re.findall(fr"\b{keyword}\b", document_lower, re.IGNORECASE)
            
            count = len(matches)
            if count > 0:
                keyword_details[category][keyword] = count * weight
                total_category_scores[category] += count * weight

    if not any(total_category_scores.values()):
        return 'UNKNOWN_DOCTYPE', 0, {}

    max_score = max(total_category_scores.values())
    max_score_category = max(total_category_scores, key=total_category_scores.get)

    # Return the winning category, its total score, and the keyword breakdown
    return max_score_category, max_score, keyword_details

