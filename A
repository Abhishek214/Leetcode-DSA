from unittest.mock import MagicMock
import util.db_handler as db_handler
from dcrest_logger.logger import logger

def test_alter_table_executes_and_commits():
    mock_cur = MagicMock()
    mock_conn = MagicMock()
    
    # Run structural alteration migration logic
    db_handler.alter_table(mock_conn, mock_cur)
    
    # Confirms both the ALTER and UPDATE statements were run sequentially
    assert mock_cur.execute.call_count == 2
    mock_conn.commit.assert_called_once()

def test_alter_table_on_exception_rolls_back():
    mock_cur = MagicMock()
    mock_cur.execute.side_effect = Exception("boom")
    mock_conn = MagicMock()
    
    try:
        db_handler.alter_table(mock_conn, mock_cur)
    except Exception:
        pass
        
    # Validates that any failure at step 1 triggers a safety fallback rollback
    assert mock_cur.execute.call_count == 1
    mock_conn.rollback.assert_called_once()

# Execution pipeline blocks
if __name__ == "__main__":
    test_alter_table_on_exception_rolls_back()
    test_alter_table_executes_and_commits()
    logger.info(f"✅ Pvt passed for {JIRA}")
